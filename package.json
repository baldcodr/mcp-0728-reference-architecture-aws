{
  "name": "mcp-aws-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation: MCP 2026-07-28 server on AWS Lambda, API Gateway, DynamoDB, Cognito via Serverless Framework v4",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "package": "serverless package",
    "assert:template": "node scripts/assert-template.mjs",
    "scan": "checkov -d .serverless --framework cloudformation --quiet",
    "verify:artifact": "npm run package && npm run assert:template && npm run scan",
    "verify:negative": "bash scripts/negative-paths.sh",
    "verify:idempotency": "bash scripts/idempotency-runtime.sh",
    "call:dataset-open": "bash scripts/dataset-open.sh",
    "deploy": "serverless deploy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-xray-sdk-core": "^3.12.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "serverless": "^4.41.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
