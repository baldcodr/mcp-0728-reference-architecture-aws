      "dot": "cyan",
      "title": "Stateless by Design",
      "items": [
        "2026-07-28 removes protocol sessions and the init handshake",
        "Any Lambda instance can serve any request",
        "Continuity lives in explicit handles (SEP-2567)"
      ]
    },
    {
      "dot": "rose",
      "title": "Defense in Depth",
      "items": [
        "Cognito at the edge, second JWT verifier inside Lambda",
        "Handles bound to the verified client_id owner",
        "Uniform unknown_handle avoids an existence oracle"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic Replay",
      "items": [
        "Handle + response committed in one TransactWriteItems",
        "Idempotency keys hashed; same key with changed input is rejected",
        "Full whitepaper on the AAIF blog: aaif.io/blog"
      ]
    }
